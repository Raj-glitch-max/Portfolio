---
import Base from '../layouts/Base.astro';
import ControlPlane from '../components/ControlPlane.astro';
import Cluster from '../components/Cluster.astro';
import { PROFILE, EDUCATION, CERTIFICATIONS, SKILLS, PROJECTS, OTHER, TOTAL_STARS } from '../data/site';

const tfwhy = PROJECTS.find((p) => p.slug === 'tf-why')!;
const desc =
  'Raj Patil — backend and AI-infrastructure engineer in Pune. I build the control plane for AI agents: capability authorization bound to workload identity, an incident-response pipeline behind a human approval gate, and a Kubernetes benchmark that measures whether an LLM actually read the evidence.';
---

<Base title="Home" description={desc} path="/">
  <!-- ABOVE THE FOLD: the claim, the proof it is checkable, then a running cluster. -->
  <section class="wrap" style="padding-block:2.5rem 1rem">
    <p class="eyebrow" style="margin-bottom:1.25rem">
      {PROFILE.title} · {PROFILE.location}
    </p>

    <h1 style="max-width:26ch">I build the control plane for AI agents.</h1>

    <p class="lede" style="max-width:60ch;margin-top:1.125rem">
      What an agent is allowed to do, and whether you can trust what it concluded.
      Below is a running service graph. Break it, and watch an agent diagnose the
      incident you just caused — then watch it keep that answer after you take the
      evidence away.
    </p>

    <div style="display:flex;flex-wrap:wrap;gap:1.25rem;align-items:center;margin:1.5rem 0 1.75rem">
      <div class="btn-row">
        <a class="btn btn--primary" href={PROFILE.links.resume}>Résumé (PDF)</a>
        <a class="btn" href={PROFILE.links.github} rel="me">GitHub</a>
        <a class="btn" href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
      </div>
      <div class="facts">
        <span><b>{TOTAL_STARS}★</b> across 6 tools</span>
        <span><b>AWS</b> SA Associate</span>
        <span><b>{PROFILE.graduated}</b></span>
      </div>
    </div>

    <Cluster />

    <p class="mono faint" style="font-size:.6875rem;margin-top:.875rem;max-width:64ch">
      Not a video and not a mock-up — a service graph simulated in the page, with the fault
      types and evidence taken from KLRB's scenarios. {PROFILE.status}.
    </p>
  </section>

  <!-- THE SYSTEM -->
  <section class="wrap" style="padding-top:2rem">
    <p class="eyebrow">The system</p>
    <p style="max-width:58ch;color:var(--text-dim);margin-bottom:2.5rem">
      Three of these are not separate projects. They are one control plane, built in the order
      I discovered I needed them — and they call each other. Every box below is a repository
      you can read.
    </p>

    <ControlPlane />
  </section>

  <!-- ADJACENT: honest about not being in the same path -->
  <section class="wrap" style="padding-top:1rem">
    <p class="eyebrow">Adjacent — same question, one layer down</p>
    <a class="card" href={`/${tfwhy.slug}`} style="--c:var(--attribute);max-width:46rem">
      <div class="card__top">
        <span class="card__name">{tfwhy.name}</span>
        <span class="badge badge--plane" style="--c:var(--attribute)">attribute</span>
      </div>
      <p class="card__line">{tfwhy.oneLine}</p>
      <div class="card__stack">
        {tfwhy.stack.join(' · ')} <span class="stars" style="margin-left:.5rem">★ {tfwhy.stars}</span>
      </div>
    </a>
    <p class="note" style="margin-top:1rem;--c:var(--attribute)">
      Atlas asks whether a caller <em>may</em> act. tf.why asks who already <em>did</em>.
      It does not wire into the pipeline above — it is a standalone CLI, and I would rather say so
      than draw an arrow that isn't there.
    </p>
  </section>

  <!-- EVERYTHING ELSE, compact and unembellished -->
  <section class="wrap">
    <p class="eyebrow">Earlier work</p>
    <div class="grid grid--2" style="max-width:62rem">
      {OTHER.map((p) => (
        <a class="card" href={`/${p.slug}`} style={`--c:var(--${p.plane})`}>
          <div class="card__top">
            <span class="card__name">{p.name}</span>
            <span class="stars">★ <b>{p.stars}</b></span>
          </div>
          <p class="card__line">{p.oneLine}</p>
          <div class="card__stack">{p.stack.slice(0, 4).join(' · ')}</div>
        </a>
      ))}
    </div>
    <p class="note" style="margin-top:1.25rem">
      There are ~60 repositories on my GitHub. These six are the ones worth your time; the rest are
      coursework, forks and experiments, and I would rather point you at four good things than forty.
    </p>
  </section>

  <!-- BACKGROUND: the fields a screener is paid to extract, in one place -->
  <section class="wrap">
    <p class="eyebrow">Background</p>
    <div class="grid grid--2" style="max-width:62rem;gap:2.5rem">
      <div>
        <h3 style="margin-bottom:.75rem">Education</h3>
        <p style="color:var(--text-dim);margin:0">
          <b style="color:var(--text)">{EDUCATION.institution}</b><br />
          {EDUCATION.degree}<br />
          <span class="mono faint" style="font-size:.8125rem">{EDUCATION.duration} · CGPA {EDUCATION.cgpa}</span>
        </p>

        <h3 style="margin:2rem 0 .75rem">Certifications</h3>
        <ul class="evidence" style="--c:var(--line-bright)">
          {CERTIFICATIONS.map((c) => <li>{c}</li>)}
        </ul>
      </div>

      <div>
        <h3 style="margin-bottom:1rem">Skills</h3>
        {SKILLS.map((s) => (
          <div style="margin-bottom:1.125rem">
            <div class="mono faint" style="font-size:.6875rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:.375rem">
              {s.group}
            </div>
            <div style="color:var(--text-dim);font-size:.9375rem">{s.items.join(', ')}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="wrap" style="border-top:1px solid var(--line)">
    <h2>Hiring for backend, platform, or agent infrastructure?</h2>
    <p style="max-width:52ch;color:var(--text-dim);margin-top:1rem">
      I am looking for a first role where the hard part is correctness under adversarial conditions —
      authorization, evaluation, incident response. Happy to walk you through the 12 deployment defects
      the Atlas audit found, or why KLRB's ablation is the only honest way I know to score an
      AI incident responder.
    </p>
    <div class="btn-row" style="margin-top:1.75rem">
      <a class="btn btn--primary" href={`mailto:${PROFILE.email}?subject=Role%20enquiry`}>Email me</a>
      <a class="btn" href={PROFILE.links.linkedin} rel="me">LinkedIn</a>
      <a class="btn" href={PROFILE.links.resume}>Résumé (PDF)</a>
    </div>
  </section>
</Base>
