---
/**
 * The hero is a running cluster, in three dimensions, that you can break.
 *
 * Traffic actually flows. Kill a pod and it stays in the service's endpoints,
 * so it keeps taking its share of requests and those requests visibly fail.
 * An agent then sweeps the cluster, collects evidence and reports a root cause
 * — and then you delete the evidence and ask again, and the answer does not
 * move. You caused the incident, so you already know what the truth was.
 *
 * Rendered with hand-written WebGL: two hundred lines of renderer and seventy
 * of matrix maths, rather than 150KB of engine to draw ten nodes. Deferred,
 * paused off-screen and on hidden tabs, and under prefers-reduced-motion it
 * runs no loop at all while the incident still resolves.
 */
---

<div class="stagefix" data-cluster aria-hidden="true">
  <canvas class="cx__canvas" data-gl></canvas>
  <canvas class="cx__canvas" data-2d hidden></canvas>
</div>

<p class="cx__fallback" data-fallback hidden>
  A live service graph — ingress to api-gateway to checkout-api to postgres and redis —
  with traffic flowing between replicas.
</p>

<!-- Telemetry stays on screen the whole way down: the cluster is always running. -->
<div class="tele" data-tele>
  <span><b data-rps>0</b> req/s</span>
  <span><b data-err>0.0</b>% err</span>
  <span class="tele__p" data-phase>healthy</span>
</div>

<script>
  import { m4, perspective, lookAt, mul, program, rgb } from '../lib/gl';

  type Phase = 'healthy' | 'failing' | 'investigating' | 'diagnosed' | 'ablated';
  interface Pod { x: number; y: number; z: number; tier: number; i: number; health: number; dead: boolean; pulse: number; }
  interface P { from: Pod; to: Pod; t: number; speed: number; bad: boolean; }

  const C = {
    ok: rgb('#3fb8d4'), bad: rgb('#e05c5c'), warn: rgb('#f0b429'),
    eval: rgb('#9d8cf5'), edge: rgb('#39424a'),
  };
  const TIERS = [{ n: 1 }, { n: 3 }, { n: 3 }, { n: 3 }];

  const FAULTS: Record<string, { label: string; target: number; evidence: string[][]; rca: string; conf: number }> = {
    oom: {
      label: 'OOMKilled', target: 2,
      evidence: [
        ['event', 'Killing container checkout-api: OOMKilled (exit 137)'],
        ['log', 'fatal: runtime: out of memory — cannot allocate 24MB'],
        ['log', 'handler.go:212 request buffer grew to 241MB'],
        ['metric', 'memory_working_set → 256Mi (limit 256Mi)'],
      ],
      rca: 'The container was OOMKilled. Memory working set reached the 256Mi limit, driven by an unbounded request buffer in the handler path.',
      conf: 0.91,
    },
    crash: {
      label: 'CrashLoopBackOff', target: 1,
      evidence: [
        ['event', 'Back-off restarting failed container api-gateway'],
        ['log', 'panic: nil pointer dereference in router.Init'],
        ['log', 'config: MISSING key AUTH_ISSUER_URL'],
        ['metric', 'restart_count → 7 in 4m'],
      ],
      rca: 'api-gateway is crash-looping on startup: a nil dereference in router.Init caused by a missing AUTH_ISSUER_URL config key.',
      conf: 0.88,
    },
    net: {
      label: 'NetworkPartition', target: 3,
      evidence: [
        ['event', 'Readiness probe failed: dial tcp 10.44.2.9:5432 i/o timeout'],
        ['log', 'pq: could not connect to server: connection timed out'],
        ['log', 'pool: 0/20 connections healthy, draining'],
        ['metric', 'db_connection_errors → 412/min'],
      ],
      rca: 'checkout-api cannot reach postgres: a network partition is timing out every connection attempt and the pool has drained.',
      conf: 0.86,
    },
  };

  const VS = `
    attribute vec3 aPos; attribute vec4 aCol; attribute float aSize;
    uniform mat4 uMVP; uniform float uPix;
    varying vec4 vCol;
    void main() {
      vec4 p = uMVP * vec4(aPos, 1.0);
      gl_Position = p;
      float fade = clamp(1.0 - (p.w - 4.5) / 11.0, 0.22, 1.0);
      vCol = vec4(aCol.rgb, aCol.a * fade);
      gl_PointSize = max(1.0, aSize * uPix / max(0.3, p.w));
    }`;

  const FS = `
    precision mediump float;
    varying vec4 vCol;
    uniform int uMode;            // 0 line, 1 soft glow, 2 crisp ring
    void main() {
      float a = 1.0;
      if (uMode > 0) {
        float r = length(gl_PointCoord - 0.5) * 2.0;
        if (uMode == 1) { a = smoothstep(1.0, 0.0, r); a *= a; }
        else { a = smoothstep(0.70, 0.52, r) * smoothstep(0.24, 0.40, r); }
      }
      // Premultiplied additive. Alpha must carry the coverage too: a point
      // sprite is a square quad, and writing alpha 1.0 for every fragment
      // makes the transparent corners composite as an opaque black box.
      float o = vCol.a * a;
      gl_FragColor = vec4(vCol.rgb * o, o);
    }`;

  const root = document.querySelector<HTMLElement>('[data-cluster]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const cvGL = root.querySelector<HTMLCanvasElement>('[data-gl]')!;
    const cv2 = root.querySelector<HTMLCanvasElement>('[data-2d]')!;
    let cv: HTMLCanvasElement = cvGL;
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const elFallback = document.querySelector<HTMLElement>('[data-fallback]')!;

    let gl = cvGL.getContext('webgl', { antialias: true, alpha: true, premultipliedAlpha: true, powerPreference: 'low-power' }) as WebGLRenderingContext | null;
    let prog = gl && program(gl, VS, FS);
    let ctx: CanvasRenderingContext2D | null = null;

    /**
     * Fall back to rasterising the same 3D scene with Canvas 2D. Used when
     * WebGL is unavailable, and when a live context is lost — which really
     * happens: a GPU reset, a driver update, or a backgrounded mobile tab will
     * take the context away, and a hero that silently turns into an empty box
     * is worse than one that never had WebGL.
     */
    function fallback2D() {
      if (ctx) return;
      gl = null; prog = null;
      cvGL.hidden = true; cv2.hidden = false;
      cv = cv2;
      ctx = cv2.getContext('2d');
      if (!ctx) { cv2.hidden = true; elFallback.hidden = false; stop(); return; }
      layout(); paint();
    }

    cvGL.addEventListener('webglcontextlost', (e) => { e.preventDefault(); fallback2D(); });
    if (!gl || !prog) { fallback2D(); } else { elFallback.hidden = true; }

    // Telemetry lives outside the stage element now, so it is queried from the
    // document rather than scoped to the stage — `$` would return null and the
    // first frame would throw.
    const elRps = document.querySelector<HTMLElement>('[data-rps]')!;
    const elErr = document.querySelector<HTMLElement>('[data-err]')!;
    const elPhase = document.querySelector<HTMLElement>('[data-phase]')!;
    const tele = document.querySelector<HTMLElement>('[data-tele]');

    // GL plumbing, only when we actually have a context.
    let aPos = -1, aCol = -1, aSize = -1, buf: WebGLBuffer | null = null;
    let uMVP: WebGLUniformLocation | null = null, uPix: WebGLUniformLocation | null = null, uMode: WebGLUniformLocation | null = null;
    if (gl && prog) {
      aPos = gl.getAttribLocation(prog, 'aPos');
      aCol = gl.getAttribLocation(prog, 'aCol');
      aSize = gl.getAttribLocation(prog, 'aSize');
      uMVP = gl.getUniformLocation(prog, 'uMVP');
      uPix = gl.getUniformLocation(prog, 'uPix');
      uMode = gl.getUniformLocation(prog, 'uMode');
      buf = gl.createBuffer();
      gl.useProgram(prog);
      gl.disable(gl.DEPTH_TEST);
      gl.enable(gl.BLEND);
      gl.blendFunc(gl.ONE, gl.ONE);      // additive: overlap blooms
      gl.clearColor(0, 0, 0, 0);
    }

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const proj = m4(), view = m4(), mvp = m4();
    let W = 0, H = 0, dpr = 1;
    let pods: Pod[] = [], parts: P[] = [];
    let phase: Phase = 'healthy';
    let fault: keyof typeof FAULTS | null = null;
    let rps = 0, err = 0, errAcc = 0, okAcc = 0, sweep = -1, spawn = 0;
    let last = 0, raf = 0, live = false;
    let scrollP = 0, ptrX = 0, ptrY = 0, tgtX = 0, tgtY = 0;
    let relayoutFrom: Map<string, Pod> | null = null;

    function mk(x: number, y: number, z: number, tier: number, i: number): Pod {
      const was = relayoutFrom?.get(tier + ':' + i);
      return { x, y, z, tier, i, health: was?.health ?? 1, dead: was?.dead ?? false, pulse: was?.pulse ?? Math.random() * 6 };
    }

    function layout() {
      const r = cv.getBoundingClientRect();
      W = Math.max(260, r.width); H = Math.max(200, r.height);
      dpr = Math.min(devicePixelRatio || 1, 2);
      cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
      if (gl) gl.viewport(0, 0, cv.width, cv.height);
      if (ctx) ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      relayoutFrom = pods.length ? new Map(pods.map((p) => [p.tier + ':' + p.i, p])) : null;
      pods = [];
      TIERS.forEach((t, ti) => {
        const x = (ti - (TIERS.length - 1) / 2) * 2.35;
        if (t.n === 1) { pods.push(mk(x, 0, 0, ti, 0)); return; }
        for (let i = 0; i < t.n; i++) {
          const a = (i / t.n) * Math.PI * 2 + ti * 0.62;
          pods.push(mk(x, Math.sin(a) * 1.18, Math.cos(a) * 1.18, ti, i));
        }
      });
      relayoutFrom = null;
    }

    const tierPods = (t: number) => pods.filter((p) => p.tier === t);

    function emit() {
      const a = tierPods(0)[0], b = tierPods(1);
      if (a && b.length) parts.push({ from: a, to: b[(Math.random() * b.length) | 0], t: 0, speed: 0.5 + Math.random() * 0.4, bad: false });
    }

    function advance(p: P): P | null {
      const next = tierPods(p.to.tier + 1);
      if (!next.length) return null;
      // A dead replica is still in the service's endpoints during the failure
      // window, so it keeps taking its share. Route uniformly and let the error
      // rate fall out of the simulation rather than asserting a number.
      const pick = next[(Math.random() * next.length) | 0];
      return { from: p.to, to: pick, t: 0, speed: 0.5 + Math.random() * 0.4, bad: pick.dead };
    }

    function step(dt: number, now: number) {
      spawn += dt;
      const rate = phase === 'healthy' ? 0.024 : 0.034;
      while (spawn > rate) { spawn -= rate; emit(); }

      let bad = 0, ok = 0;
      const spawned: P[] = [];
      parts = parts.filter((p) => {
        p.t += dt * p.speed;
        if (p.t < 1) return true;
        if (p.bad) { bad++; return false; }
        const n = advance(p);
        if (n) spawned.push(n); else ok++;
        return false;
      });
      if (spawned.length) parts = parts.concat(spawned);

      const decay = Math.pow(0.5, dt / 1.5);
      errAcc = errAcc * decay + bad; okAcc = okAcc * decay + ok;
      const total = errAcc + okAcc;
      const tErr = total > 0.5 ? (errAcc / total) * 100 : 0;
      err += (tErr - err) * Math.min(1, dt * 1.8);
      rps += ((phase === 'healthy' ? 1240 : 980) + Math.sin(now / 900) * 60 - rps) * Math.min(1, dt * 2);

      for (const p of pods) {
        p.pulse += dt * (p.dead ? 5 : 1.5);
        p.health += ((p.dead ? 0 : 1) - p.health) * Math.min(1, dt * 3);
      }
      if (sweep >= 0) sweep = Math.min(1.4, sweep + dt * 0.5);

      ptrX += (tgtX - ptrX) * Math.min(1, dt * 3);
      ptrY += (tgtY - ptrY) * Math.min(1, dt * 3);

      elRps.textContent = String(Math.round(rps));
      elErr.textContent = err.toFixed(1);
    }

    // A path rather than a pan: scrolling walks the camera through the graph —
    // wide establishing shot, push inside the mesh, orbit the failing tier,
    // then pull back out. [progress, radius, azimuth, elevation]
    const PATH: [number, number, number, number, number, number][] = [
      [0.00, 9.2, -0.52, 0.15, -1.9,  0.95],
      [0.22, 5.6, -0.04, 0.10, -0.7,  0.35],
      [0.46, 4.2,  0.86, 0.28,  0.4, -0.15],
      [0.70, 6.4,  1.62, 0.40, -0.9,  0.55],
      [1.00, 9.0,  2.30, 0.28, -1.6,  0.85],
    ];
    const smooth = (t: number) => t * t * (3 - 2 * t);

    function camera(now: number) {
      let i = 0;
      while (i < PATH.length - 2 && scrollP > PATH[i + 1][0]) i++;
      const a = PATH[i], b = PATH[i + 1];
      const t = smooth(Math.max(0, Math.min(1, (scrollP - a[0]) / (b[0] - a[0] || 1))));
      const lp = (x: number, y: number) => x + (y - x) * t;

      // A slow drift and a little pointer parallax keep it alive when the page
      // is still; neither is large enough to fight the scroll path.
      const az = lp(a[2], b[2]) + Math.sin(now * 0.00012) * 0.09 + ptrX * 0.20;
      const el = lp(a[3], b[3]) + Math.sin(now * 0.00017) * 0.025 + ptrY * 0.12;
      const R = lp(a[1], b[1]);
      const tx = lp(a[4], b[4]), ty = lp(a[5], b[5]);
      const ce = Math.cos(el);
      lookAt(view,
        [tx + Math.sin(az) * ce * R, ty + Math.sin(el) * R, Math.cos(az) * ce * R],
        [tx, ty, 0], [0, 1, 0]);
      perspective(proj, 0.82, W / H, 0.1, 60);
      mul(mvp, proj, view);
    }

    /** @returns [screenX, screenY, w] where w is view depth, or null if behind. */
    function project(x: number, y: number, z: number): [number, number, number] | null {
      const m = mvp;
      const cw = m[3] * x + m[7] * y + m[11] * z + m[15];
      if (cw <= 0.01) return null;
      const cx = m[0] * x + m[4] * y + m[8] * z + m[12];
      const cy = m[1] * x + m[5] * y + m[9] * z + m[13];
      return [(cx / cw * 0.5 + 0.5) * W, (1 - (cy / cw * 0.5 + 0.5)) * H, cw];
    }

    const lerp3 = (a: Pod, b: Pod, t: number): [number, number, number] =>
      [a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t];

    // ---------- WebGL renderer ----------

    const vbuf: number[] = [];
    const pushV = (arr: number[], x: number, y: number, z: number, c: number[], al: number, sz: number) =>
      arr.push(x, y, z, c[0], c[1], c[2], al, sz);

    function upload(data: number[], mode: number, prim: number) {
      if (!gl || !data.length) return;
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(data), gl.DYNAMIC_DRAW);
      const S = 8 * 4;
      gl.enableVertexAttribArray(aPos); gl.vertexAttribPointer(aPos, 3, gl.FLOAT, false, S, 0);
      gl.enableVertexAttribArray(aCol); gl.vertexAttribPointer(aCol, 4, gl.FLOAT, false, S, 12);
      gl.enableVertexAttribArray(aSize); gl.vertexAttribPointer(aSize, 1, gl.FLOAT, false, S, 28);
      gl.uniform1i(uMode, mode);
      gl.drawArrays(prim, 0, data.length / 8);
    }

    function drawGL() {
      if (!gl) return;
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.uniformMatrix4fv(uMVP, false, mvp);
      gl.uniform1f(uPix, cv.height * 0.92);

      vbuf.length = 0;
      for (let t = 0; t < TIERS.length - 1; t++)
        for (const a of tierPods(t)) for (const b of tierPods(t + 1)) {
          const hit = a.dead || b.dead, c = hit ? C.bad : C.edge, al = hit ? 0.55 : 0.42;
          pushV(vbuf, a.x, a.y, a.z, c, al, 1); pushV(vbuf, b.x, b.y, b.z, c, al, 1);
        }
      for (const p of parts) {
        const c = p.bad ? C.bad : C.ok;
        const [ax, ay, az] = lerp3(p.from, p.to, Math.max(0, p.t - 0.13));
        const [bx, by, bz] = lerp3(p.from, p.to, p.t);
        pushV(vbuf, ax, ay, az, c, 0.05, 1);
        pushV(vbuf, bx, by, bz, c, p.bad ? 1 : 0.85, 1);
      }
      upload(vbuf, 0, gl.LINES);

      vbuf.length = 0;
      for (const p of pods) {
        const c = p.dead ? C.bad : p.health < 0.85 ? C.warn : C.ok;
        const a = p.dead ? 0.55 + Math.sin(p.pulse) * 0.30 : 0.20 + Math.sin(p.pulse) * 0.06;
        pushV(vbuf, p.x, p.y, p.z, c, Math.max(0.02, a), p.dead ? 0.95 : 0.74);
      }
      upload(vbuf, 1, gl.POINTS);

      vbuf.length = 0;
      for (const p of parts) {
        const [x, y, z] = lerp3(p.from, p.to, p.t);
        pushV(vbuf, x, y, z, p.bad ? C.bad : C.ok, p.bad ? 1 : 0.9, 0.075);
      }
      upload(vbuf, 1, gl.POINTS);

      vbuf.length = 0;
      for (const p of pods) {
        const c = p.dead ? C.bad : p.health < 0.85 ? C.warn : C.ok;
        pushV(vbuf, p.x, p.y, p.z, c, 1, 0.185);
      }
      upload(vbuf, 2, gl.POINTS);

      if (sweep >= 0) {
        vbuf.length = 0;
        const sx = -4.6 + sweep * 9.2;
        for (let k = 0; k <= 8; k++) {
          const a = (k / 8) * Math.PI * 2;
          pushV(vbuf, sx, Math.sin(a) * 1.75, Math.cos(a) * 1.75, C.eval, 0.5, 1);
          pushV(vbuf, sx, Math.sin(a + 0.8) * 1.75, Math.cos(a + 0.8) * 1.75, C.eval, 0.12, 1);
        }
        upload(vbuf, 0, gl.LINES);
      }
    }

    // ---------- Canvas 2D renderer: the same 3D scene, rasterised by hand ----------

    const css = (c: number[], a: number) =>
      `rgba(${(c[0] * 255) | 0},${(c[1] * 255) | 0},${(c[2] * 255) | 0},${a.toFixed(3)})`;
    const depth = (w: number) => Math.max(0.22, Math.min(1, 1 - (w - 4.5) / 11));

    function draw2D() {
      if (!ctx) return;
      ctx.clearRect(0, 0, W, H);
      ctx.lineCap = 'round';

      for (let t = 0; t < TIERS.length - 1; t++)
        for (const a of tierPods(t)) for (const b of tierPods(t + 1)) {
          const pa = project(a.x, a.y, a.z), pb = project(b.x, b.y, b.z);
          if (!pa || !pb) continue;
          const hit = a.dead || b.dead;
          ctx.strokeStyle = css(hit ? C.bad : C.edge, (hit ? 0.55 : 0.46) * depth((pa[2] + pb[2]) / 2));
          ctx.lineWidth = 1;
          ctx.beginPath(); ctx.moveTo(pa[0], pa[1]); ctx.lineTo(pb[0], pb[1]); ctx.stroke();
        }

      for (const p of parts) {
        const [ax, ay, az] = lerp3(p.from, p.to, Math.max(0, p.t - 0.13));
        const [bx, by, bz] = lerp3(p.from, p.to, p.t);
        const pa = project(ax, ay, az), pb = project(bx, by, bz);
        if (!pa || !pb) continue;
        const d = depth(pb[2]);
        const g = ctx.createLinearGradient(pa[0], pa[1], pb[0], pb[1]);
        g.addColorStop(0, css(p.bad ? C.bad : C.ok, 0));
        g.addColorStop(1, css(p.bad ? C.bad : C.ok, (p.bad ? 1 : 0.85) * d));
        ctx.strokeStyle = g; ctx.lineWidth = 1.7 * d;
        ctx.beginPath(); ctx.moveTo(pa[0], pa[1]); ctx.lineTo(pb[0], pb[1]); ctx.stroke();
      }

      for (const p of pods) {
        const s = project(p.x, p.y, p.z);
        if (!s) continue;
        const d = depth(s[2]), c = p.dead ? C.bad : p.health < 0.85 ? C.warn : C.ok;
        const rad = (p.dead ? 44 : 34) * d, core = 10 * d;
        const a = p.dead ? 0.55 + Math.sin(p.pulse) * 0.28 : 0.22 + Math.sin(p.pulse) * 0.06;
        const g = ctx.createRadialGradient(s[0], s[1], 0, s[0], s[1], rad);
        g.addColorStop(0, css(c, Math.max(0.02, a)));
        g.addColorStop(1, css(c, 0));
        ctx.fillStyle = g;
        ctx.beginPath(); ctx.arc(s[0], s[1], rad, 0, 7); ctx.fill();
        ctx.strokeStyle = css(c, d); ctx.lineWidth = 1.6;
        ctx.beginPath(); ctx.arc(s[0], s[1], core, 0, 7); ctx.stroke();
        if (p.dead) {
          ctx.beginPath();
          ctx.moveTo(s[0] - core * .5, s[1] - core * .5); ctx.lineTo(s[0] + core * .5, s[1] + core * .5);
          ctx.moveTo(s[0] + core * .5, s[1] - core * .5); ctx.lineTo(s[0] - core * .5, s[1] + core * .5);
          ctx.stroke();
        }
      }

      for (const p of parts) {
        const [x, y, z] = lerp3(p.from, p.to, p.t);
        const s = project(x, y, z);
        if (!s) continue;
        const d = depth(s[2]);
        ctx.fillStyle = css(p.bad ? C.bad : C.ok, (p.bad ? 1 : 0.85) * d);
        ctx.beginPath(); ctx.arc(s[0], s[1], 2.6 * d, 0, 7); ctx.fill();
      }

      if (sweep >= 0) {
        const sx = -4.6 + sweep * 9.2;
        ctx.strokeStyle = css(C.eval, 0.5); ctx.lineWidth = 1;
        ctx.beginPath();
        for (let k = 0; k <= 32; k++) {
          const a = (k / 32) * Math.PI * 2;
          const s = project(sx, Math.sin(a) * 1.75, Math.cos(a) * 1.75);
          if (!s) continue;
          k ? ctx.lineTo(s[0], s[1]) : ctx.moveTo(s[0], s[1]);
        }
        ctx.stroke();
      }
    }

    /**
     * A lost context is easy to detect; a context that survives but renders
     * nothing is not, and that failure mode shows the visitor an empty box
     * forever. So after the first few frames, read back a block of the
     * framebuffer once: if WebGL drew nothing, fall back to 2D. readPixels is
     * valid here because it runs inside the same frame as the draw.
     */
    let selfCheck = 0;
    function verifyGL() {
      if (!gl || selfCheck > 6) return;
      if (++selfCheck < 6) return;
      const w = Math.min(260, cv.width), h = Math.min(180, cv.height);
      const x = Math.max(0, (cv.width - w) >> 1), y = Math.max(0, (cv.height - h) >> 1);
      const px = new Uint8Array(w * h * 4);
      gl.readPixels(x, y, w, h, gl.RGBA, gl.UNSIGNED_BYTE, px);
      let lit = 0;
      for (let i = 0; i < px.length; i += 4) if (px[i] + px[i + 1] + px[i + 2] > 12) { if (++lit > 24) return; }
      fallback2D();
    }

    function draw(now: number) {
      camera(now);
      if (gl) { drawGL(); verifyGL(); } else { draw2D(); }
    }

    function loop(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000 || 0);
      last = now;
      step(dt, now); draw(now);
      raf = requestAnimationFrame(loop);
    }
    function paint() { if (!live) draw(performance.now()); }
    function start() { if (!live && !reduced.matches) { live = true; last = performance.now(); raf = requestAnimationFrame(loop); } }
    function stop() { if (live) { live = false; cancelAnimationFrame(raf); } }

    // ---- incident flow, driven by the page ----
    //
    // The component owns the simulation; the page owns the narrative. Acts
    // dispatch cluster:inject / cluster:ablate / cluster:reset as they scroll
    // into view, and the component reports back with cluster:phase so the
    // copy can react. Neither side reaches into the other.

    function setPhase(p: Phase, label?: string) {
      phase = p;
      elPhase.textContent = label ?? p;
      elPhase.dataset.p = p;
      document.body.dataset.incident = p === 'healthy' ? '' : p;
      document.dispatchEvent(new CustomEvent('cluster:phase', { detail: { phase: p, fault } }));
    }

    function inject(kind: keyof typeof FAULTS) {
      if (fault || !FAULTS[kind]) return;
      fault = kind;
      const f = FAULTS[kind];
      const victims = tierPods(f.target);
      if (victims.length) victims[0].dead = true;
      setPhase('failing', f.label);
      paint();
      setTimeout(() => {
        setPhase('investigating'); sweep = 0; paint();
        setTimeout(() => { sweep = -1; diagnose(); }, reduced.matches ? 0 : 2400);
      }, 650);
    }

    function diagnose() {
      if (!fault || phase === 'diagnosed' || phase === 'ablated') return;
      setPhase('diagnosed');
      paint();
    }

    function reset() {
      fault = null; sweep = -1;
      pods.forEach((p) => (p.dead = false));
      parts = []; errAcc = 0; okAcc = 0;
      setPhase('healthy'); paint();
    }

    document.addEventListener('cluster:inject', (e) => inject(((e as CustomEvent).detail?.fault ?? 'oom')));
    document.addEventListener('cluster:ablate', () => { if (fault) { setPhase('ablated'); paint(); } });
    document.addEventListener('cluster:reset', () => reset());

    // ---- lifecycle ----

    // The camera path spans the narrative acts — roughly the first six
    // viewports — after which the stage recedes so the work below reads clean.
    let scrollQueued = false;
    function onScroll() {
      if (scrollQueued) return;
      scrollQueued = true;
      requestAnimationFrame(applyScroll);
    }
    function applyScroll() {
      scrollQueued = false;
      const span = innerHeight * 6;
      scrollP = Math.max(0, Math.min(1, scrollY / span));
      const fade = Math.max(0, Math.min(1, (scrollY - span * 0.92) / (innerHeight * 0.8)));
      root.style.opacity = String(1 - fade * 0.88);
      if (tele) tele.style.opacity = String(1 - fade * 0.7);
    }

    layout(); applyScroll(); draw(performance.now());



    // The stage is the fixed full-bleed element itself now.
    new ResizeObserver(() => { layout(); paint(); }).observe(root);
    new IntersectionObserver((e) => (e[0].isIntersecting ? start() : stop()), { threshold: 0.01 }).observe(root);
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('pointermove', (e) => {
      const r = root.getBoundingClientRect();
      tgtX = Math.max(-1, Math.min(1, (e.clientX - r.left - r.width / 2) / (r.width / 2)));
      tgtY = Math.max(-1, Math.min(1, (e.clientY - r.top - r.height / 2) / (r.height / 2)));
    }, { passive: true });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    reduced.addEventListener('change', () => (reduced.matches ? stop() : start()));
  }
</script>

<style>
  .stagefix { opacity: 1; transition: opacity .5s linear; }
  .cx__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  /* Tier labels ride the projected 3D positions. */
  .cx__labels { position: absolute; inset: 0; transition: opacity .4s linear; }
  .cx__lab {
    position: absolute; top: 0; left: 0;
    font-family: var(--mono); font-size: .625rem; letter-spacing: .14em;
    text-transform: uppercase; color: #565e65; white-space: nowrap;
    transition: color .4s; will-change: transform;
  }
  .cx__lab.is-hit { color: var(--fail); }
  @media (max-width: 40rem) { .cx__labels { display: none; } }

  .cx__fallback {
    position: relative; z-index: 2;
    margin: 0; padding: 1.25rem 0; color: var(--text-dim); font-size: .9375rem;
  }

  /* Telemetry is always on screen: the cluster is always running. */
  .tele {
    position: fixed; z-index: 5; left: 16px; bottom: 14px;
    display: flex; gap: 1rem; align-items: center;
    font-family: var(--mono); font-size: .6875rem; color: var(--text-faint);
    pointer-events: none; transition: opacity .5s linear;
  }
  @media (min-width: 40rem) { .tele { left: 32px; bottom: 20px; } }
  .tele b { color: var(--text-dim); font-weight: 500; }
  .tele__p {
    text-transform: uppercase; letter-spacing: .18em;
    padding: .1rem .45rem; border: 1px solid var(--line-bright); border-radius: 3px;
    transition: color .4s, border-color .4s;
  }
  .tele__p[data-p='healthy'] { color: var(--act); border-color: #204a55; }
  .tele__p[data-p='failing'] { color: var(--fail); border-color: #5c2424; }
  .tele__p[data-p='investigating'],
  .tele__p[data-p='diagnosed'],
  .tele__p[data-p='ablated'] { color: var(--evaluate); border-color: #453a6b; }
</style>
